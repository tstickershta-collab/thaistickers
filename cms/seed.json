{"shell": "<!doctype html><html lang=\"th\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>ThaiStickers — ไอเดียคุณ งานพิมพ์เรา</title><meta name=\"description\" content=\"สติ๊กเกอร์ฉลากสินค้า ปลอกแก้ว ปลอกไอศครีม สติ๊กเกอร์ชิ้น และสติ๊กเกอร์ตกแต่งร้าน เปลี่ยนไอเดียให้เป็นงานพิมพ์ของแบรนด์คุณ\"><meta name=\"theme-color\" content=\"#f7f1e6\"><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap\" rel=\"stylesheet\"><style>\n:root{--cream:#f7f1e6;--ink:#292a23;--orange:#ed592c;--line:#d9d1c2;--sage:#e3e6d5}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:100px}body{margin:0;background:var(--cream);color:var(--ink);font-family:'Noto Sans Thai',sans-serif}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}a,button{touch-action:manipulation}a:focus-visible,button:focus-visible{outline:3px solid var(--orange);outline-offset:5px}.wrap{width:min(1280px,calc(100% - 96px));margin:auto}header{position:sticky;top:0;background:#f7f1e6f5;border-bottom:1px solid var(--line);z-index:20}.top{height:90px;display:flex;align-items:center;justify-content:space-between;gap:30px}.logo{font:700 27px 'Space Grotesk';letter-spacing:-1.5px}.logo span{color:var(--orange)}nav{display:flex;align-items:center;gap:28px;font-size:13px}nav .selected{color:var(--orange)}.button,.btn{border:1px solid var(--ink);padding:13px 21px;border-radius:5px;display:inline-flex;justify-content:center;align-items:center;gap:25px;font-size:13px;font-weight:600}.button.orange{background:var(--orange);border-color:var(--orange);color:#fff}.button.dark{background:var(--ink);color:var(--cream)}.menu{display:none;border:1px solid var(--line);padding:9px 13px;border-radius:4px;background:none}.hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:55px;padding:75px 0 85px}.eyebrow{font:500 11px 'Space Grotesk';letter-spacing:2px;display:flex;align-items:center;gap:10px}.eyebrow:before{content:'';width:7px;height:7px;background:var(--orange);border-radius:50%}h1{font-size:clamp(45px,5.2vw,76px);font-weight:800;line-height:1.22;letter-spacing:-2.5px;margin:28px 0 24px}h1 em{font-style:normal;color:var(--orange)}.intro{font-size:15px;line-height:1.95;color:#747569;max-width:440px}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.tiny{margin-top:24px;font-size:11px;color:#747569}.tiny span{margin-right:16px}.tiny span:before{content:'✓ ';color:var(--orange)}.collage{height:530px;position:relative;border-radius:10px;background:#e5e6d7;overflow:hidden;background-image:linear-gradient(#c9cebb55 1px,transparent 1px),linear-gradient(90deg,#c9cebb55 1px,transparent 1px);background-size:38px 38px}.photo{position:absolute;width:55%;height:55%;object-fit:cover;border:9px solid #fffcf2;box-shadow:8px 16px 25px #292a2330}.photo.one{top:42px;left:25px;transform:rotate(-10deg)}.photo.two{bottom:40px;right:18px;transform:rotate(10deg)}.seal{position:absolute;right:22px;top:21px;background:var(--orange);color:#fff8e7;border-radius:50%;height:100px;width:100px;display:grid;place-content:center;text-align:center;font:500 12px 'Space Grotesk';transform:rotate(13deg);line-height:1.5}.seal b{font-size:29px}.swatches{position:absolute;bottom:30px;left:24px;display:flex;gap:5px;transform:rotate(-8deg)}.swatches i{display:block;width:26px;height:55px;border:4px solid #fffcf2}.sticker-word{position:absolute;left:21px;top:47%;background:var(--cream);border:1px solid var(--ink);padding:8px 18px;border-radius:40px;font:700 21px 'Space Grotesk';transform:rotate(-8deg)}.tape{padding:20px 15px;background:var(--orange);color:var(--cream);font:600 clamp(13px,2vw,23px) 'Space Grotesk';letter-spacing:2px;display:flex;justify-content:space-around;gap:20px;overflow:hidden;white-space:nowrap}.principles{padding:40px 0;display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line);gap:30px}.principles b{display:block;font-size:14px;font-weight:600;margin-bottom:6px}.principles p{margin:0;color:#7a7b6b;font-size:12px}.principles .icon{font-size:23px;color:var(--orange);margin-bottom:12px}.section{padding:85px 0}.section-title{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:40px}h2{font-size:clamp(30px,3.3vw,46px);line-height:1.3;letter-spacing:-1.4px;margin:19px 0 0;font-weight:700}h2 em{font-style:normal;color:var(--orange)}.sub{color:#77796c;font-size:14px;line-height:1.9;margin:16px 0 0}.textlink{font-size:13px;border-bottom:1px solid var(--ink);padding-bottom:7px;white-space:nowrap}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:34px 25px}.product{display:block}.art{height:280px;position:relative;display:grid;place-items:center;border-radius:7px;overflow:hidden;background:#e5e6db;transition:transform .25s}.product:hover .art{transform:translateY(-6px)}.art img{width:100%;height:100%;object-fit:cover}.tag{position:absolute;top:15px;left:15px;background:var(--cream);padding:6px 11px;border-radius:30px;font-size:10px;z-index:1}.product h3{font-size:19px;font-weight:600;margin:18px 0 7px;display:flex;justify-content:space-between}.product p{font-size:12px;line-height:1.8;color:#7b7e70;margin:0}.number{font:11px 'Space Grotesk';color:#8b8f7d;display:block;margin-top:18px}.cup{width:135px;height:175px;background:#faf9ec;clip-path:polygon(0 0,100% 0,84% 100%,16% 100%);border-top:10px solid #343a30;display:grid;place-content:center;filter:drop-shadow(10px 10px 10px #0003);transform:rotate(-12deg)}.sleeve{background:#ca9766;padding:25px 8px;text-align:center;font:27px Georgia;color:#454d31}.sleeve small,.cone small,.shop small{font:7px 'Space Grotesk';letter-spacing:1px;display:block;margin-top:7px}.cone{height:205px;width:155px;background:#f2845b;clip-path:polygon(0 0,100% 0,50% 100%);text-align:center;padding-top:30px;font:29px Georgia;color:#fff0d8;transform:rotate(15deg)}.shop{width:190px;height:170px;border:10px solid #3d5544;background:#aec7bd;display:grid;place-content:center;transform:rotate(-8deg);box-shadow:14px 18px 0 #0001;text-align:center;font:38px Georgia;color:#fff8de}.custom-card{background:var(--sage);border:1px solid #d2d7c0;border-radius:7px;display:flex;flex-direction:column;justify-content:center;padding:30px}.custom-card .spark{font-size:44px;color:var(--orange)}.custom-card h3{font-size:25px;line-height:1.4;font-weight:600;margin:15px 0}.custom-card p{font-size:13px;line-height:1.9;color:#6b745e}.custom-card a{align-self:flex-start;margin-top:15px}.note{font-size:10px;color:#878a7a;margin-top:25px}.process{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#efeadf}.process-grid{display:grid;grid-template-columns:1fr 1.45fr;gap:90px}.step{padding:22px 0;border-bottom:1px solid #d3d0c3;display:grid;grid-template-columns:35px 1fr;gap:20px}.step:first-child{padding-top:0}.step:last-child{border:0}.step span{font:12px 'Space Grotesk';color:var(--orange);padding-top:5px}.step h3{font-size:20px;font-weight:600;margin:0 0 10px}.step p{font-size:13px;line-height:1.85;color:#7a7c6e;margin:0}.story{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}.story-visual{background:#e7e8dc;padding:22px;border-radius:7px;transform:rotate(-2deg)}.story-visual img{display:block;width:100%;border-radius:3px}.story-visual p{font:10px 'Space Grotesk';letter-spacing:2px;margin:16px 0 0;color:#656c58}.quote{font-size:22px;line-height:1.7;border-left:3px solid var(--orange);padding-left:22px;margin:25px 0}.cta{background:var(--orange);padding:65px 25px;text-align:center;color:var(--cream);border-radius:9px;margin-bottom:80px}.cta .eyebrow{justify-content:center}.cta .eyebrow:before{background:var(--cream)}.cta h2{font-size:clamp(38px,5vw,64px);margin:20px 0}.cta p{font-size:14px;line-height:1.9;color:#ffe2d1}.cta .button{margin-top:20px}footer{background:#272c22;color:var(--cream);padding:55px 0 25px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px}.footer-grid p{font-size:12px;line-height:1.9;color:#aeb7a2}.footer-grid h3{font-size:12px;letter-spacing:1px;margin:0 0 20px}.footer-grid a:not(.logo){display:block;color:#c4cbb9;font-size:12px;margin-bottom:12px}.fine{border-top:1px solid #47503d;margin-top:35px;padding-top:22px;display:flex;justify-content:space-between;font:10px 'Space Grotesk';color:#9ca78d}.mobile-contact{display:none}@media(max-width:1000px){.wrap{width:calc(100% - 48px)}nav{gap:17px}.top{gap:15px}.top>.button{display:none}.hero{gap:25px}.collage{height:460px}.grid{gap:25px 18px}.art{height:240px}.process-grid{gap:40px}.story{gap:35px}.logo{font-size:24px}}@media(max-width:700px){.wrap{width:calc(100% - 36px)}.top{height:74px}.menu{display:block}nav{display:none;position:absolute;top:74px;left:0;right:0;background:var(--cream);padding:22px;border-bottom:1px solid var(--line);flex-direction:column;align-items:stretch;gap:22px}nav.open{display:flex}.hero{grid-template-columns:1fr;padding:40px 0 40px;gap:30px}h1{font-size:53px;margin-top:22px;letter-spacing:-2px}.intro{font-size:14px}.hero .eyebrow{font-size:9px;letter-spacing:1.6px}.collage{height:390px}.seal{width:80px;height:80px;font-size:10px}.seal b{font-size:22px}.principles{grid-template-columns:1fr 1fr;padding:28px 0;gap:25px}.principles b{font-size:12px}.principles p{font-size:11px}.section{padding:55px 0}.section-title{align-items:start;gap:20px;flex-direction:column;margin-bottom:28px}.grid{grid-template-columns:repeat(2,1fr);gap:28px 13px}.art{height:205px}.tag{font-size:9px;top:10px;left:10px}.product h3{font-size:15px;gap:7px}.product p{font-size:11px}.cup{width:100px;height:145px}.sleeve{font-size:23px;padding:18px 5px}.cone{height:160px;width:120px;font-size:25px}.shop{width:130px;height:140px;font-size:30px;border-width:7px}.custom-card{padding:18px}.custom-card h3{font-size:19px;margin:10px 0}.custom-card p{font-size:11px}.custom-card .spark{font-size:27px}.custom-card .textlink{font-size:11px}.process-grid,.story{grid-template-columns:1fr;gap:32px}.process-grid h2 br{display:none}.quote{font-size:20px}.cta{padding:45px 18px;margin-bottom:50px}.footer-grid{grid-template-columns:1fr 1fr;gap:25px}.footer-grid>div:first-child{grid-column:1/-1}.fine{gap:20px;font-size:9px;padding-bottom:45px}.mobile-contact{display:flex;position:fixed;bottom:0;left:0;right:0;z-index:15;background:var(--cream);border-top:1px solid var(--line);padding:9px 16px;gap:10px}.mobile-contact a{flex:1;font-size:12px;padding:10px}.tape span:last-child{display:none}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.art{transition:none}}\n</style></head><body>{{CONTENT}}<div class=\"mobile-contact\"><a class=\"button\" href=\"tel:0967060137\">โทรสอบถาม</a><a class=\"button orange\" href=\"/catalog#estimate\">เริ่มโปรเจกต์ ↗</a></div><script>const toggle=document.querySelector('.menu'),nav=document.querySelector('#navigation');toggle.onclick=()=>{const open=nav.classList.toggle('open');toggle.setAttribute('aria-expanded',String(open));toggle.textContent=open?'ปิด ✕':'เมนู ☰'};nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');toggle.setAttribute('aria-expanded','false');toggle.textContent='เมนู ☰'}));</script></body></html>\n", "templates": {"original0": {"html": "<header><div class=\"wrap top\"><a href=\"{{f0}}\" class=\"logo\">{{f1}}<span>{{f2}}</span></a><nav id=\"navigation\" aria-label=\"เมนูหลัก\"><a class=\"selected\" href=\"{{f3}}\" aria-current=\"page\">{{f4}}</a><a href=\"{{f5}}\">{{f6}}</a><a href=\"{{f7}}\">{{f8}}</a><a href=\"{{f9}}\">{{f10}}</a><a class=\"btn admin-entry\" href=\"{{f11}}\">{{f12}}</a></nav><a class=\"button dark\" href=\"{{f13}}\">{{f14}}</a><button class=\"menu\" aria-controls=\"navigation\" aria-expanded=\"false\" aria-label=\"เปิดเมนู\">{{f15}}</button></div></header>", "fields": {"f0": {"value": "/", "kind": "