{"shell": "<!doctype html><html lang=\"th\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>ThaiStickers — งานพิมพ์ที่ทำให้แบรนด์คุณเป็นตัวเอง</title><meta name=\"description\" content=\"ต้นแบบโรงพิมพ์ออนไลน์ สติ๊กเกอร์ฉลากสินค้า ปลอกแก้ว ปลอกไอศครีม สติ๊กเกอร์ชิ้น และสติ๊กเกอร์ตกแต่งร้าน พร้อมเลือกสเปกและขอใบเสนอราคา\"><link href=\"https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap\" rel=\"stylesheet\"><style>\n:root{--ink:#23251f;--orange:#ed592c;--cream:#f6f4ed;--line:#dfdfd4}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--cream);color:var(--ink);font-family:'Noto Sans Thai',sans-serif}button,input,select{font:inherit}button,a{touch-action:manipulation}a{color:inherit;text-decoration:none}button{cursor:pointer}header{position:sticky;top:0;z-index:10;background:#f6f4edf5;border-bottom:1px solid var(--line)}.nav{max-width:1320px;margin:auto;height:90px;display:flex;align-items:center;justify-content:space-between;padding:0 38px}.logo{font:700 27px 'Space Grotesk';letter-spacing:-1.5px}.logo span{color:var(--orange)}nav{display:flex;gap:32px;font-size:14px}nav a:hover{color:var(--orange)}.btn{border:1px solid var(--ink);padding:13px 23px;display:inline-flex;gap:22px;align-items:center;justify-content:center;background:transparent;border-radius:5px;font-weight:600;font-size:14px}.btn.primary{background:var(--orange);border-color:var(--orange);color:white}.btn.dark{background:var(--ink);color:white}.wrap{max-width:1320px;margin:auto;padding:0 38px}.hero{display:grid;grid-template-columns:1fr 1fr;min-height:635px;align-items:center;gap:35px}.eyebrow{font:500 12px 'Space Grotesk';letter-spacing:2px;display:flex;align-items:center;gap:10px}.dot{height:8px;width:8px;border-radius:50%;background:var(--orange)}h1{font-size:59px;letter-spacing:-2px;line-height:1.25;font-weight:600;margin:28px 0 20px}h1 em{font-style:normal;color:var(--orange)}.lead{color:#73756b;line-height:1.9;font-size:15px;max-width:440px}.actions{display:flex;gap:12px;margin:30px 0}.micro{display:flex;gap:22px;color:#62675b;font-size:12px}.micro span:before{content:'✓';margin-right:7px;color:var(--orange)}.scene{background:#e8eadf;height:510px;border-radius:10px;position:relative;overflow:hidden}.scene svg{width:100%;height:100%}.scene .caption{position:absolute;bottom:22px;left:26px;font:11px 'Space Grotesk';letter-spacing:2px}.badge{position:absolute;top:25px;right:25px;border:1px solid #59624f;border-radius:50%;height:89px;width:89px;display:grid;place-content:center;text-align:center;font:11px 'Space Grotesk';transform:rotate(13deg);line-height:1.5}.strip{border-block:1px solid var(--line);padding:21px 0;display:flex;justify-content:space-around;gap:20px;color:#65685d;font-size:13px}.strip b{font:20px 'Space Grotesk';color:#34382d;margin-right:9px}.section{padding:80px 0}.sectionhead{display:flex;justify-content:space-between;align-items:end;margin-bottom:30px}h2{font-size:32px;font-weight:600;letter-spacing:-.8px;margin:12px 0 0}.muted{color:#777b70;font-size:14px}.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:25px}.filter{border:1px solid var(--line);border-radius:30px;padding:8px 18px;background:transparent;color:#6c7064;font-size:13px}.filter.active{background:var(--ink);color:white;border-color:var(--ink)}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{background:transparent;border:0;padding:0;text-align:left;color:var(--ink)}.art{height:245px;border-radius:8px;position:relative;overflow:hidden;display:grid;place-items:center;transition:transform .25s}.card:hover .art{transform:translateY(-5px)}.card h3{font-size:17px;margin:17px 0 6px;font-weight:600}.card p{font-size:12px;color:#797d70;margin:0}.card .bottom{display:flex;justify-content:space-between;margin-top:17px;font-size:13px}.arrow{font-size:20px}.label{position:absolute;top:14px;left:14px;background:#ffffffbc;border-radius:30px;font-size:10px;padding:5px 9px}.object{filter:drop-shadow(9px 18px 12px #0002);transform:rotate(-10deg)}.box{width:125px;height:150px;background:#cf653e;display:grid;place-content:center;color:#f8e8ce;border-right:18px solid #ae4d2b;border-top:10px solid #e3895e;text-align:center;font:30px 'Space Grotesk';line-height:1.1}.box small{font:8px 'Space Grotesk';letter-spacing:2px;margin-top:15px}.sticker{border-radius:50%;height:135px;width:135px;background:#e3ed9e;display:grid;place-content:center;text-align:center;font:700 29px 'Space Grotesk';border:5px solid white;box-shadow:-35px 24px 0 -3px #fcf5de,25px 27px 0 -5px #eddba8;color:#435333}.bag{width:132px;height:145px;background:#e2b27c;border-right:18px solid #c99b65;position:relative;display:grid;place-content:center;font:22px 'Space Grotesk';color:#5d492f}.bag:before{content:'';position:absolute;width:43px;height:47px;border:4px solid #836a4c;border-bottom:0;border-radius:30px 30px 0 0;top:-36px;left:32px}.paper{width:145px;height:100px;background:#405943;color:#ececce;display:grid;place-content:center;font:22px 'Space Grotesk';box-shadow:8px 8px 0 #fff,12px 12px 0 #c9cbbf}.estimate{background:#e9ecdf;border-radius:10px;padding:44px;display:grid;grid-template-columns:1fr 1.1fr;gap:70px}.estimate h2{font-size:35px}.estimate p{color:#6f7566;font-size:14px;line-height:1.9}.quoteform{display:grid;grid-template-columns:1fr 1fr;gap:17px}label{font-size:12px;display:block}select,input{width:100%;border:1px solid #d0d5c5;background:#f8f9f3;border-radius:5px;padding:12px;margin-top:7px;color:var(--ink)}.total{grid-column:1/-1;border-top:1px solid #ccd2bf;padding-top:16px;display:flex;align-items:center;justify-content:space-between}.total strong{font:600 30px 'Space Grotesk'}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:45px;margin-top:35px}.step{border-top:1px solid var(--line);padding-top:20px}.step span{font:13px 'Space Grotesk';color:var(--orange)}.step h3{font-size:20px;font-weight:500;margin:20px 0 10px}.step p{font-size:14px;color:#777b70;line-height:1.8}.faq{border-top:1px solid var(--line);padding-top:45px;margin-top:50px;display:grid;grid-template-columns:1fr 1.5fr;gap:50px}details{border-bottom:1px solid var(--line);padding:17px 0;font-size:14px}summary{cursor:pointer}details p{color:#707567;font-size:13px;line-height:1.9}.cta{background:var(--orange);color:#fff;padding:45px;border-radius:8px;display:flex;justify-content:space-between;align-items:center;margin-bottom:65px}.cta h2{margin:0 0 9px}.cta p{margin:0;font-size:14px;color:#ffddcf}footer{background:#23291f;color:#eaede2;padding:45px 0 25px}.foot{display:flex;justify-content:space-between;gap:30px}.foot p{color:#b2baa8;font-size:12px;line-height:1.9}.footlinks{display:flex;gap:50px;font-size:13px}.footlinks a{display:block;margin-bottom:13px}.fine{border-top:1px solid #42483b;margin-top:35px;padding-top:20px;font-size:10px;color:#a3ac98;display:flex;justify-content:space-between}dialog{border:0;border-radius:12px;max-width:530px;width:92%;padding:35px;background:var(--cream);color:var(--ink)}dialog::backdrop{background:#18201799}.close{float:right;border:0;background:transparent;font-size:25px}.notice{font-size:12px;color:#7b7f71;line-height:1.8}#result{white-space:pre-line;background:#e9ecdf;padding:15px;border-radius:5px;display:none;margin-top:15px;font-size:13px}@media(max-width:900px){nav{gap:16px}.nav{padding:0 22px}.wrap{padding:0 22px}.hero{gap:20px}h1{font-size:43px}.scene{height:430px}.products{grid-template-columns:repeat(2,1fr)}.estimate{gap:25px;padding:30px}.strip{flex-wrap:wrap}}@media(max-width:620px){.nav{height:75px}.nav>.btn{padding:10px 14px}nav{display:none}.hero{grid-template-columns:1fr;padding-top:35px;padding-bottom:32px}h1{font-size:44px}.hero .scene{height:370px}.hero .lead{font-size:14px}.strip{justify-content:flex-start;font-size:11px}.strip b{font-size:16px}.section{padding:50px 0}.sectionhead{align-items:start;gap:15px}.sectionhead>.muted{display:none}h2{font-size:27px}.art{height:190px}.products{gap:22px 13px}.card h3{font-size:15px}.card .bottom{font-size:11px}.estimate{grid-template-columns:1fr;gap:20px;padding:25px}.estimate h2{font-size:29px}.steps{grid-template-columns:1fr;gap:20px}.step h3{margin:10px 0}.faq{grid-template-columns:1fr;gap:15px}.cta{padding:28px;display:block}.cta .btn{margin-top:23px}.foot{display:block}.footlinks{margin-top:25px}.fine{gap:20px}.micro{gap:13px;font-size:11px}.actions{gap:8px}.btn{padding:12px 17px}}\n.card[hidden]{display:none}.cup{height:165px;width:125px;background:#faf7ec;clip-path:polygon(0 0,100% 0,85% 100%,15% 100%);display:grid;align-items:center;border-top:10px solid #34382d}.sleeve{background:#c49c70;padding:23px 8px;text-align:center;font:28px Georgia;color:#425238}.sleeve small,.cone small,.shop small{display:block;font:7px 'Space Grotesk';letter-spacing:1px;margin-top:8px}.cone{height:170px;width:135px;clip-path:polygon(0 0,100% 0,50% 100%);background:#ed764e;text-align:center;color:#fff0d6;padding-top:30px;font:25px Georgia}.shop{width:170px;height:155px;background:#c8d9d5;border:9px solid #405943;display:grid;place-items:center;position:relative}.shop:before{content:'';position:absolute;left:25%;top:0;height:100%;border-left:4px solid #405943}.shop span{position:relative;color:#fff;font:32px Georgia;text-align:center}.shop small{font-size:9px}.hero-art{display:flex;align-items:center;justify-content:center;gap:25px;height:100%;flex-wrap:wrap;padding:80px 35px}.hero-art .cup{width:155px;height:220px}.hero-art .cone{width:155px;height:205px}.hero-art .sticker{height:115px;width:115px;font-size:24px}.hero-art .shop{width:155px;height:135px}@media(max-width:620px){.hero-art{gap:20px;padding:65px 25px 45px}.hero-art .cup{height:145px;width:105px}.hero-art .cone{height:145px;width:105px}.hero-art .sticker{height:85px;width:85px;font-size:16px}.hero-art .shop{width:115px;height:90px}.hero-art .shop span{font-size:25px}}.managed-image{width:100%;height:100%;object-fit:cover;display:block}.scene.has-image{height:auto;min-height:230px;background:#fff}.scene.has-image .managed-image{height:auto;object-fit:contain}.scene.has-image .badge,.scene.has-image .caption{display:none}.art .managed-image{object-fit:contain}.image-credit{font-size:11px;color:#73756b;margin-top:15px;line-height:1.8}.admin-entry{background:#e9ecdf;border-color:#cbd0bf;font-size:13px;padding:11px 15px}@media(max-width:620px){.nav{gap:10px}.nav>.btn:not(.admin-entry){display:none}.nav .admin-entry{display:inline-flex;margin-left:auto}.logo{font-size:27px}}</style></head><body>{{CONTENT}}<dialog id=\"quote\"><button class=\"close\" aria-label=\"ปิด\" onclick=\"document.querySelector('#quote').close()\">×</button><div class=\"eyebrow\">YOUR NEXT PROJECT</div><h2>เริ่มต้นโปรเจกต์</h2><p class=\"notice\">จัดเตรียมบรีฟสำหรับขอใบเสนอราคา ดาวน์โหลดไฟล์แล้วส่งให้ทีมงานผ่าน Facebook ข้อมูลจะยังไม่ถูกส่งอัตโนมัติ</p><form id=\"brief\"><label>ประเภทงาน<select id=\"briefProduct\"><option>สติ๊กเกอร์ฉลากสินค้า</option><option>ปลอกแก้ว</option><option>ปลอกไอศครีม</option><option>สติ๊กเกอร์ชิ้น</option><option>สติ๊กเกอร์ตกแต่งร้าน</option></select></label><label style=\"margin-top:15px\">รายละเอียดงาน / ขนาด / จำนวน<input id=\"briefText\" required placeholder=\"เช่น สติ๊กเกอร์ฉลาก 5 × 8 ซม. จำนวน 500 ชิ้น\"></label><button class=\"btn primary\" style=\"margin-top:20px\" type=\"submit\">สร้างสรุปบรีฟ ↗</button></form><div id=\"result\" role=\"status\"></div><button id=\"download\" class=\"btn\" style=\"display:none;margin-top:12px\">ดาวน์โหลดบรีฟ .txt ↓</button><a class=\"btn dark\" href=\"https://www.facebook.com/thaistickersdotcom\" target=\"_blank\" rel=\"noopener\" style=\"margin-top:12px\">ติดต่อทีมงานทาง Facebook ↗</a></dialog><script>\nconst $=s=>document.querySelector(s);document.querySelectorAll('.filter').forEach(b=>b.onclick=()=>{document.querySelectorAll('.filter').forEach(t=>t.classList.toggle('active',t===b));document.querySelectorAll('.card').forEach(c=>c.hidden=b.dataset.filter!=='all'&&c.dataset.category!==b.dataset.filter)});function calc(){$('#price').textContent='สอบถามตามสเปก'}document.querySelectorAll('.quoteform select').forEach(e=>e.onchange=calc);calc();function openQuote(product){if(product)$('#briefProduct').value=product;$('#result').style.display='none';$('#download').style.display='none';$('#quote').showModal()}$('#quote').addEventListener('click',e=>{if(e.target===$('#quote')&& (e.offsetX<0||e.offsetY<0||e.offsetX>e.target.clientWidth||e.offsetY>e.target.clientHeight))e.target.close()});let brief='';$('#brief').onsubmit=e=>{e.preventDefault();brief='บรีฟงานพิมพ์ — ThaiStickers\\nประเภท: '+$('#briefProduct').value+'\\nรายละเอียด: '+$('#briefText').value+'\\n\\nกรุณายืนยันสเปก ราคา และระยะเวลาผลิตกับโรงพิมพ์\\nเอกสารนี้เป็นบรีฟเพื่อขอใบเสนอราคา ยังไม่ใช่คำสั่งผลิต';$('#result').textContent=brief;$('#result').style.display='block';$('#download').style.display='inline-flex'};$('#download').onclick=()=>{const url=URL.createObjectURL(new Blob(['\\ufeff'+brief],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='thaistickers-print-brief.txt';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};\n</script><script>const category=new URLSearchParams(location.search).get('category');if(category){const filter=document.querySelector('[data-filter=\"'+CSS.escape(category)+'\"]');if(filter)filter.click();}</script></body></html>\n", "templates": {"catalog0": {"html": "<header><div class=\"nav\"><a class=\"logo\" href=\"{{f0}}\">{{f1}}<span>{{f2}}</span></a><nav><a href=\"{{f3}}\">{{f4}}</a><a href=\"{{f5}}\">{{f6}}</a><a href=\"{{f7}}\">{{f8}}</a><a href=\"{{f9}}\">{{f10}}</a><a href=\"{{f11}}\">{{f12}}</a></nav><a class=\"btn admin-entry\" href=\"{{f13}}\">{{f14}}</a><button class=\"btn\" onclick=\"openQuote()\">{{f15}}<span>{{f16}}</span></button></div></header>", "fields": {"f0": {"value": "/", "kind": "url"}, "f1": {"value": 